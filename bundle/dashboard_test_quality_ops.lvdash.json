{
  "datasets": [
    {
      "name": "ds_counter_total_dies_30d",
      "displayName": "Counter: Total Dies Tested (Last 30d)",
      "queryLines": [
        "SELECT total_dies_30d FROM parijat_demos.manufacturing.gold_counter_total_dies_30d "
      ]
    },
    {
      "name": "ds_counter_avg_fpy_14d",
      "displayName": "Counter: Avg FPY (Last 14d)",
      "queryLines": [
        "SELECT avg_fpy_14d FROM parijat_demos.manufacturing.gold_counter_avg_fpy_14d "
      ]
    },
    {
      "name": "ds_counter_avg_retest_14d",
      "displayName": "Counter: Avg Retest Rate (Last 14d)",
      "queryLines": [
        "SELECT avg_retest_rate_14d FROM parijat_demos.manufacturing.gold_counter_avg_retest_14d "
      ]
    },
    {
      "name": "ds_counter_avg_uph_7d",
      "displayName": "Counter: Avg UPH (Trailing 7d)",
      "queryLines": [
        "SELECT avg_uph_7d FROM parijat_demos.manufacturing.gold_counter_avg_uph_7d "
      ]
    },
    {
      "name": "ds_test_kpis_daily",
      "displayName": "Daily Test KPIs",
      "queryLines": [
        "SELECT date, site, product, foundry, dies_tested, dies_pass_fp, dies_fail, fpy, retest_rate, fpy_baseline_21d FROM parijat_demos.manufacturing.gold_test_kpis_daily ORDER BY date, site, product "
      ]
    },
    {
      "name": "ds_bin_mix_weekly",
      "displayName": "Weekly Failure Bin Mix",
      "queryLines": [
        "SELECT week_start, site, product, hard_bin AS hard_bin_code, CASE WHEN hard_bin IN ('HB_014','HB_021','HB_007','HB_032') THEN hard_bin ELSE 'Other' END AS hard_bin_group, die_count FROM parijat_demos.manufacturing.gold_bin_mix_weekly ORDER BY week_start, site, hard_bin_group "
      ]
    },
    {
      "name": "ds_param_drift_timeseries",
      "displayName": "Parameter Drift Timeseries",
      "queryLines": [
        "SELECT date, site, product, param_code, mean_z, pct_limit_breach FROM parijat_demos.manufacturing.gold_param_drift_timeseries ORDER BY date, site, param_code "
      ]
    },
    {
      "name": "ds_change_log",
      "displayName": "Equipment and Recipe Change Log",
      "queryLines": [
        "SELECT change_time, date, week_start, site, tester_id, change_type, scope, ecr_id, details FROM parijat_demos.manufacturing.gold_change_log ORDER BY change_time DESC "
      ]
    },
    {
      "name": "ds_impact_cumulative",
      "displayName": "Cumulative Impact (Lost Dies and Cost)",
      "queryLines": [
        "SELECT date, site, cumulative_lost_dies, cumulative_cost_usd FROM parijat_demos.manufacturing.gold_impact_cumulative ORDER BY date, site "
      ]
    }
  ],
