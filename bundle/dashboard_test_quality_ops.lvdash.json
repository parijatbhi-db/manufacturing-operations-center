    {
      "name": "test_quality_ops",
      "displayName": "Semiconductor Test Quality and Throughput",
      "layout": [
        {
          "widget": {
            "name": "header_story",
            "multilineTextboxSpec": {
              "lines": [
                "# Semiconductor Test Quality and Throughput\n",
                "Executive monitoring of FPY, bin and parameter shifts, site-equipment isolation, change log alignment, and business impact in die loss and throughput.\n",
                "The MX-7 AUS anomaly (2025-08-18..2025-08-27) should stand out while keeping full-run context.\n"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi_total_dies_30d",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_counter_total_dies_30d",
                  "fields": [
                    {
                      "name": "sum(total_dies_30d)",
                      "expression": "SUM(`total_dies_30d`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(total_dies_30d)",
                  "displayName": "Total Dies (30d)",
                  "format": {
                    "type": "number",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 0
                    }
                  }
                }
              },
              "frame": {
                "title": "Total Dies Tested (Last 30d)",
                "showTitle": true,
                "description": "Total die count tested over trailing 30 days across all sites/products; context for scale.",
                "showDescription": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 2,
            "height": 3
          }
        },
